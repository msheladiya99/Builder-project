{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode — matches Vite's module handling */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* JSX transform — required for React 17+ auto-import */
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    /* Path aliases — match vite.config.ts resolve.alias */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }

    /* NOTE: No explicit "types" array — TypeScript will auto-discover
       all installed @types/* packages (react, react-dom, node, etc.).
       Vite-specific globals (import.meta.env) are provided via
       src/vite-env.d.ts using triple-slash references. */
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
